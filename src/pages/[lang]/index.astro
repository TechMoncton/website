---
import BaseLayout from '@/layouts/BaseLayout.astro';
import EventList from '@/components/astro/EventList.astro';
import SubscribeForm from '@/components/astro/SubscribeForm.astro';
import { Card, CardContent } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { useTranslations, type Language } from '@/i18n';
import { fetchAllEvents, getUpcomingEvents } from '@/lib/events';
import { getLocalizedPath } from '@/i18n';
import Hero from '@/components/astro/Hero.astro';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'fr' } }];
}

const lang = Astro.params.lang as Language;
const t = useTranslations(lang);

// Fetch events at build time
const allEvents = await fetchAllEvents();
const upcomingEvents = getUpcomingEvents(allEvents).slice(0, 3);
---

<BaseLayout title={t('nav.home')} lang={lang}>
  <Hero title={t('home.hero.title')} subtitle={t('home.hero.subtitle')}>
    <div slot="actions">
      <a
        href="https://discord.gg/axYagWhk6Y"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Button
          size="lg"
          className="rounded-full px-10 py-7 text-lg font-semibold bg-[#5865F2] hover:bg-[#4752C4] text-white shadow-lg hover:shadow-xl transition-all hover:scale-105 gap-3"
        >
          <svg
            viewBox="0 0 24 24"
            fill="currentColor"
            class="w-6 h-6"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M20.317 4.492c-1.53-.69-3.17-1.2-4.885-1.49a.075.075 0 0 0-.079.036c-.21.369-.444.85-.608 1.23a18.566 18.566 0 0 0-5.487 0 12.36 12.36 0 0 0-.617-1.23A.077.077 0 0 0 8.562 3c-1.714.29-3.354.8-4.885 1.491a.07.07 0 0 0-.032.027C.533 9.093-.32 13.555.099 17.961a.08.08 0 0 0 .031.055 20.03 20.03 0 0 0 5.993 2.98.078.078 0 0 0 .084-.026c.462-.62.874-1.275 1.226-1.963.021-.04.001-.088-.041-.104a13.201 13.201 0 0 1-1.872-.878.075.075 0 0 1-.008-.125c.126-.093.252-.19.372-.287a.075.075 0 0 1 .078-.01c3.927 1.764 8.18 1.764 12.061 0a.075.075 0 0 1 .079.009c.12.098.245.195.372.288a.075.075 0 0 1-.006.125c-.598.344-1.22.635-1.873.877a.075.075 0 0 0-.041.105c.36.687.772 1.341 1.225 1.962a.077.077 0 0 0 .084.028 19.963 19.963 0 0 0 6.002-2.981.076.076 0 0 0 .032-.054c.5-5.094-.838-9.52-3.549-13.442a.06.06 0 0 0-.031-.028zM8.02 15.278c-1.182 0-2.157-1.069-2.157-2.38 0-1.312.956-2.38 2.157-2.38 1.21 0 2.176 1.077 2.157 2.38 0 1.312-.956 2.38-2.157 2.38zm7.975 0c-1.183 0-2.157-1.069-2.157-2.38 0-1.312.955-2.38 2.157-2.38 1.21 0 2.176 1.077 2.157 2.38 0 1.312-.946 2.38-2.157 2.38z"
            ></path>
          </svg>
          {t('home.hero.joinDiscord')}
        </Button>
      </a>
    </div>
  </Hero>

  <div class="container pb-16 lg:pb-24 space-y-24">
    <!-- Upcoming Events Section -->
    <section>
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold">{t('home.upcoming.title')}</h2>
      </div>
      <div class="max-w-xl mx-auto">
        <EventList
          events={upcomingEvents}
          translations={{
            speaker: t('events.speaker'),
            date: t('events.date'),
            time: t('events.time'),
            location: t('events.location'),
            upcomingBadge: t('events.upcomingBadge'),
          }}
          emptyMessage={t('home.upcoming.noEvents')}
          lang={lang}
          layout="list"
        />
      </div>
      <div class="mt-10 text-center">
        <a href={getLocalizedPath('events', lang)}>
          <Button variant="outline" size="lg"
            >{t('home.upcoming.viewAll')}</Button
          >
        </a>
      </div>
    </section>

    <!-- Newsletter Section -->
    <section>
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold">{t('subscribe.title')}</h2>
        <p class="mt-4 text-xl text-muted-foreground max-w-2xl mx-auto">
          {t('subscribe.description')}
        </p>
      </div>
      <div class="max-w-xl mx-auto">
        <Card className="hover:border-primary/40 transition-colors">
          <CardContent>
            <SubscribeForm lang={lang} />
          </CardContent>
        </Card>
      </div>
    </section>
  </div>
</BaseLayout>
