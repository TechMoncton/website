---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Card, CardHeader, CardTitle, CardContent } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { useTranslations, type Language } from '@/i18n';
import {
  MessageSquare,
  Calendar,
  Info,
  HandHelping,
  Scale,
  HelpCircle,
} from 'lucide-react';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'fr' } }];
}

const lang = Astro.params.lang as Language;
const t = useTranslations(lang);

const slackLink =
  'https://join.slack.com/t/monctontechhive/shared_invite/zt-3rnwe6rxi-nQfSTkRoHQUDAx5xqED2IQ';

// Helper to bold labels (text before colon)
const formatLabels = (text: string) => {
  if (text.includes(':')) {
    const [label, ...rest] = text.split(':');
    return `<strong class="font-bold text-foreground">${label}:</strong> ${rest.join(':')}`;
  }
  return text;
};
---

<BaseLayout title={t('nav.about')} lang={lang}>
  <div class="container py-8 pb-20 space-y-12">
    <!-- Header Section -->
    <section class="text-center py-12">
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
        {t('about.title')}
      </h1>
      <p class="mt-4 text-xl text-muted-foreground max-w-2xl mx-auto">
        {t('about.description')}
      </p>
    </section>

    <div class="grid gap-8 md:grid-cols-2">
      <!-- When and Where -->
      <Card className="hover:border-primary/40 transition-colors">
        <CardHeader>
          <CardTitle className="flex items-center gap-2">
            <Calendar className="w-5 h-5 text-primary" />
            <span>{t('about.sections.whenAndWhere.title')}</span>
          </CardTitle>
        </CardHeader>
        <CardContent className="space-y-4 text-muted-foreground">
          <p set:html={formatLabels(t('about.sections.whenAndWhere.time'))} />
          <p set:html={formatLabels(t('about.sections.whenAndWhere.start'))} />
          <p set:html={formatLabels(t('about.sections.whenAndWhere.venue'))} />
          <p set:html={formatLabels(t('about.sections.whenAndWhere.after'))} />
        </CardContent>
      </Card>

      <!-- Slack Hub -->
      <Card className="hover:border-primary/40 transition-colors">
        <CardHeader>
          <CardTitle className="flex items-center gap-2">
            <MessageSquare className="w-5 h-5 text-primary" />
            <span>{t('about.sections.slack.title')}</span>
          </CardTitle>
        </CardHeader>
        <CardContent className="space-y-4">
          <p class="font-semibold text-primary">
            {t('about.sections.slack.subtitle')}
          </p>
          <div class="pt-2">
            <a href={slackLink} target="_blank" rel="noopener noreferrer">
              <Button
                className="w-full sm:w-auto gap-2 bg-[#4A154B] hover:bg-[#611f69] text-white"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="w-5 h-5"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M5.042 15.165a2.528 2.528 0 0 1-2.52 2.523A2.528 2.528 0 0 1 0 15.165a2.527 2.527 0 0 1 2.522-2.52h2.52v2.52zM6.313 15.165a2.527 2.527 0 0 1 2.521-2.52 2.527 2.527 0 0 1 2.521 2.52v6.313A2.528 2.528 0 0 1 8.834 24a2.528 2.528 0 0 1-2.521-2.522v-6.313zM8.834 5.042a2.528 2.528 0 0 1-2.521-2.52A2.528 2.528 0 0 1 8.834 0a2.528 2.528 0 0 1 2.521 2.522v2.52H8.834zM8.834 6.313a2.528 2.528 0 0 1 2.521 2.521 2.528 2.528 0 0 1-2.521 2.521H2.522A2.528 2.528 0 0 1 0 8.834a2.528 2.528 0 0 1 2.522-2.521h6.312zM18.956 8.834a2.528 2.528 0 0 1 2.522-2.521A2.528 2.528 0 0 1 24 8.834a2.528 2.528 0 0 1-2.522 2.521h-2.522V8.834zM17.688 8.834a2.528 2.528 0 0 1-2.523 2.521 2.527 2.527 0 0 1-2.52-2.521V2.522A2.527 2.527 0 0 1 15.165 0a2.528 2.528 0 0 1 2.523 2.522v6.312zM15.165 18.956a2.528 2.528 0 0 1 2.523 2.522A2.528 2.528 0 0 1 15.165 24a2.527 2.527 0 0 1-2.52-2.522v-2.522h2.52zM15.165 17.688a2.527 2.527 0 0 1-2.52-2.523 2.526 2.526 0 0 1 2.52-2.52h6.313A2.527 2.527 0 0 1 24 15.165a2.528 2.528 0 0 1-2.522 2.523h-6.313z"
                  ></path>
                </svg>
                {t('about.sections.slack.link').split(':')[0]}
              </Button>
            </a>
          </div>
          <div class="space-y-4 text-muted-foreground">
            <p>{t('about.sections.slack.p1')}</p>
            <p>{t('about.sections.slack.p2')}</p>
            <p>{t('about.sections.slack.p3')}</p>
          </div>
        </CardContent>
      </Card>

      <!-- What to Expect -->
      <Card className="hover:border-primary/40 transition-colors">
        <CardHeader>
          <CardTitle className="flex items-center gap-2">
            <Info className="w-5 h-5 text-primary" />
            <span>{t('about.sections.expect.title')}</span>
          </CardTitle>
        </CardHeader>
        <CardContent className="space-y-4 text-muted-foreground">
          <p set:html={formatLabels(t('about.sections.expect.fees'))} />
          <p set:html={formatLabels(t('about.sections.expect.format'))} />
          <p set:html={formatLabels(t('about.sections.expect.tone'))} />
          <p set:html={formatLabels(t('about.sections.expect.networking'))} />
        </CardContent>
      </Card>

      <!-- How to Participate -->
      <Card className="hover:border-primary/40 transition-colors">
        <CardHeader>
          <CardTitle className="flex items-center gap-2">
            <HandHelping className="w-5 h-5 text-primary" />
            <span>{t('about.sections.participate.title')}</span>
          </CardTitle>
        </CardHeader>
        <CardContent className="space-y-4 text-muted-foreground">
          <p set:html={formatLabels(t('about.sections.participate.attend'))} />
          <p set:html={formatLabels(t('about.sections.participate.present'))} />
          <p set:html={formatLabels(t('about.sections.participate.share'))} />
          <p
            set:html={formatLabels(t('about.sections.participate.beWelcoming'))}
          />
        </CardContent>
      </Card>
    </div>

    <!-- CoC and FAQ side by side -->
    <div class="flex flex-col md:flex-row gap-8">
      <!-- Code of Conduct - 70% -->
      <Card className="md:w-[70%] hover:border-primary/40 transition-colors">
        <CardHeader>
          <CardTitle className="flex items-center gap-2">
            <Scale className="w-5 h-5 text-primary" />
            <span>{t('about.sections.coc.title')}</span>
          </CardTitle>
        </CardHeader>
        <CardContent
          className="grid gap-8 md:grid-cols-2 text-muted-foreground"
        >
          <div class="space-y-4">
            <h3 class="font-semibold text-lg text-foreground">
              {t('about.sections.coc.cocTitle')}
            </h3>
            <p>{t('about.sections.coc.p1')}</p>
            <p>{t('about.sections.coc.p2')}</p>
          </div>
          <div class="space-y-4 pt-6 md:pt-0 md:pl-8 md:border-l">
            <h3 class="font-semibold text-lg text-foreground">
              {t('about.sections.coc.contactTitle')}
            </h3>
            <div class="space-y-2">
              <p set:html={formatLabels(t('about.sections.coc.venue'))} />
              <p
                set:html={formatLabels(t('about.sections.coc.announcements'))}
              />
              <p set:html={formatLabels(t('about.sections.coc.organizers'))} />
            </div>
          </div>
        </CardContent>
      </Card>

      <!-- Quick FAQ - 30% -->
      <Card className="md:w-[30%] hover:border-primary/40 transition-colors">
        <CardHeader>
          <CardTitle className="flex items-center gap-2">
            <HelpCircle className="w-5 h-5 text-primary" />
            <span>{t('about.sections.faq.title')}</span>
          </CardTitle>
        </CardHeader>
        <CardContent>
          <ul class="space-y-6">
            <li class="space-y-1">
              <p class="font-semibold">
                {t('about.sections.faq.register').split(':')[0]}
              </p>
              <p class="text-muted-foreground">
                {t('about.sections.faq.register').split(':')[1]}
              </p>
            </li>
            <li class="space-y-1">
              <p class="font-semibold">
                {t('about.sections.faq.guest').split(':')[0]}
              </p>
              <p class="text-muted-foreground">
                {t('about.sections.faq.guest').split(':')[1]}
              </p>
            </li>
            <li class="space-y-1">
              <p class="font-semibold">
                {t('about.sections.faq.parking').split(':')[0]}
              </p>
              <p class="text-muted-foreground">
                {t('about.sections.faq.parking').split(':')[1]}
              </p>
            </li>
            <li class="space-y-1">
              <p class="font-semibold">
                {t('about.sections.faq.accessibility').split(':')[0]}
              </p>
              <p class="text-muted-foreground">
                {t('about.sections.faq.accessibility').split(':')[1]}
              </p>
            </li>
          </ul>
        </CardContent>
      </Card>
    </div>
  </div>
</BaseLayout>
