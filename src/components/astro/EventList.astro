---
import EventCard from './EventCard.astro';
import type { Event } from '@/lib/events';

interface Props {
  events: Event[];
  translations: {
    speaker: string;
    date: string;
    time: string;
    location: string;
    upcomingBadge: string;
  };
  emptyMessage: string;
  lang: string;
  layout?: 'grid' | 'list';
  noBorder?: boolean;
}

const {
  events,
  translations,
  emptyMessage,
  lang,
  layout = 'grid',
  noBorder = false,
} = Astro.props;
---

{
  events.length === 0 ? (
    <p class="text-muted-foreground text-center py-8">{emptyMessage}</p>
  ) : (
    <div
      class={`flex flex-wrap justify-center gap-6 ${layout === 'list' ? 'flex-col items-center' : ''}`}
    >
      {events.map((event) => (
        <div
          class={`${layout === 'list' ? 'w-full' : 'w-full md:w-[calc(50%-1.5rem)] lg:w-[calc(33.333%-1.5rem)] max-w-md'}`}
        >
          <EventCard
            event={event}
            translations={translations}
            lang={lang}
            noBorder={noBorder}
          />
        </div>
      ))}
    </div>
  )
}
